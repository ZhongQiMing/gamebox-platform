# 依赖
node_modules/
.pnpm-store/

# 构建产物
dist/
dist-seed/
build/
*.tsbuildinfo
# scripts/build-images.ps1 导出的镜像包，单个上 G
dist-images/

# 环境变量（绝不提交）
.env
.env.*
!.env.example
# APK/iOS 打包域名，无私密；另一台机器拉下来才能直接打正式包
!.env.app
scripts/health-alert.env
scripts/.health-alert-state.json
scripts/security-artifacts/
scripts/backup*.env
backups/

# 数据库（本地开发）
*.sqlite
*.sqlite-journal
*.db

# 日志
*.log
logs/

# 编辑器 / 系统
.DS_Store
.idea/
.vscode/*
!.vscode/extensions.json

# Capacitor 原生构建产物
client-app/android/app/build/
client-app/ios/App/Pods/
client-app/android/.gradle/

# 安卓签名密钥与口令（泄露＝别人能冒你的名字发更新包，绝不入库）
client-app/android/keystore.properties
*.jks
*.keystore

# 压缩包 / 备份
*.zip
*.tar.gz
*.rar
*.7z

# 上传 / 临时
uploads/
tmp/
.cache/
_tmp_*
_prototype/
bjNew/
/remove_bg.py
/remove_white_bg.py

# 游戏美术生成脚本的中间产物（按需）
games-assets/**/__pycache__/
# 时时彩摇号选型样片（仅本地预览）
games-assets/ssc/media/draw-preview/*.mp4
games-assets/ssc/media/draw-preview/*.webm
games-assets/ssc/media/draw-preview/*.ogv
# AI 分帧原图较大；动画成品 webp/gif 可按需入库，原帧默认忽略
games-assets/ssc/media/draw-preview/ai/**/*.png
# 参考站提取的开奖多帧副本（仅本地预览）
games-assets/ssc/media/draw-preview/ref-lhc/

# Python 缓存（全局）
__pycache__/
*.pyc

# scripts 工具目录：临时调试文件与爬取缓存（禁止入库）
scripts/node_modules/
scripts/_*
# 子包下的同类临时脚本（如 server/scripts/_tmp-*）
**/scripts/_*
_tmp-*
scripts/麻将胡了*/
scripts/runtime-atlas-cache/
scripts/runtime-sprites/
scripts/mahjong_img_backup/
scripts/*.png
scripts/*.jpg
scripts/*-dump.json
scripts/pg-cocos-dump.json
