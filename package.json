{
  "name": "gamebox-platform",
  "version": "0.1.0",
  "private": true,
  "description": "游戏盒子平台 · 多游戏品类 + 多级代理分销 · 仅积分模式 · 学习用途",
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "audit:rtp": "ts-node --project scripts/tsconfig.json scripts/rtp-audit.ts",
    "check:encoding": "node scripts/check-encoding.mjs",
    "build:images": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/build-images.ps1",
    "dev:server": "pnpm --filter @gamebox/server start:dev",
    "build:server": "pnpm --filter @gamebox/server build",
    "dev:app": "pnpm --filter @gamebox/client-app dev",
    "build:app": "pnpm --filter @gamebox/client-app build",
    "dev:admin": "pnpm --filter @gamebox/admin-panel dev",
    "build:admin": "pnpm --filter @gamebox/admin-panel build",
    "db:generate": "pnpm --filter @gamebox/server prisma:generate",
    "db:migrate": "pnpm --filter @gamebox/server prisma:migrate",
    "db:seed": "pnpm --filter @gamebox/server prisma:seed",
    "lint": "pnpm -r lint",
    "security:audit": "pnpm audit --registry=https://registry.npmjs.org --audit-level=high",
    "security:gate": "bash scripts/security-gate.sh",
    "format": "prettier --write \"**/*.{ts,vue,js,json,md}\""
  },
  "devDependencies": {
    "@gamebox/shared": "workspace:*",
    "@types/node": "^20.12.0",
    "prettier": "^3.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.0"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@<1.1.20": "1.1.20",
      "brace-expansion@>=2.0.0 <2.1.6": "2.1.6",
      "brace-expansion@>=3.0.0 <5.0.11": "5.0.11",
      "body-parser": "1.20.9",
      "engine.io@>=6.6.0 <6.6.10": "6.6.10",
      "fast-uri@>=3.0.0 <3.1.5": "3.1.5",
      "js-yaml@>=3.0.0 <3.15.1": "3.15.1",
      "js-yaml@>=4.0.0 <4.3.1": "4.3.1",
      "multer": "2.5.0",
      "nanoid@>=3.0.0 <3.3.17": "3.3.17",
      "postcss@>=8.0.0 <=8.5.22": "8.5.23",
      "proxy-addr": "2.0.8",
      "qs": "^6.15.2",
      "socket.io-parser": "^4.2.7",
      "tar@>=7.0.0 <=7.5.20": "7.5.21",
      "undici@>=7.0.0 <7.29.0": "7.29.0",
      "uuid@>=7.0.0 <11.1.1": "11.1.1",
      "ws": "^8.21.0"
    }
  }
}
