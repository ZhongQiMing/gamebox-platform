# ===== 服务 =====
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000

# ===== 数据库（PostgreSQL）=====
DATABASE_URL="postgresql://gamebox:CHANGE_ME@localhost:5432/gamebox?schema=public"

# ===== Redis（实时态 / 队列 / 缓存）=====
REDIS_URL="redis://localhost:6379"

# ===== JWT =====
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
JWT_EXPIRES_IN=7d

# ===== 安全 / 限流 =====
# 生产建议设置，逗号分隔；不设则生产关闭通配 CORS（依赖 nginx 同源反代）
# CORS_ORIGIN=https://yourdomain.com
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ===== 业务参数 =====
PLATFORM_FEE_RATE=0.05
DEFAULT_BALANCE=0
# 多级分润最大层级（沿代理链向上分几级）
COMMISSION_MAX_LEVEL=5

# ===== 对象存储（APK / 美术，阶段一用本地 public）=====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./public/uploads

APP_BASE_URL=https://yourdomain.com

# ===== 运维探活 / Telegram 告警（可选，详见 scripts/health-alert.env.example）=====
# 服务端本身不发 Telegram；由宝塔计划任务跑：node scripts/health-alert.mjs
# HEALTH_URL=http://127.0.0.1:3000/api/health
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ===== seed 管理员（生产必设强密码；或 SKIP_ADMIN_SEED=1）=====
# SEED_ADMIN_PASSWORD=
# SKIP_ADMIN_SEED=0

# ===== PG 备份（scripts/backup-postgres.sh，见 backup-postgres.env.example）=====
# 宝塔 cron 每日：bash /path/to/scripts/backup-postgres.sh

# ===== HTTPS =====
# 有域名后再在宝塔网站开启 SSL；未上域名前可先本机/IP 验收控制台。
