# ===== 服务 =====
NODE_ENV=development
PORT=3000
PUBLIC_BASE_URL=http://localhost:3000
# 监听地址；生产务必 127.0.0.1，只允许 Nginx 反代进来
# （直接暴露 0.0.0.0 时客户端可伪造 X-Forwarded-For，绕过按 IP 的限流与风控）
HOST=0.0.0.0
# 反代层数（Express trust proxy）：从 server 往外数有几层会往 X-Forwarded-For 追加。
# 无反代填 0；裸机上只有一层 Nginx 填 1；
# Docker 部署填 2（宿主机 Nginx → web 容器 Nginx → server），填少了 req.ip 会变成
# docker 网关地址，按 IP 的限流与同 IP 多号风控会一起失灵。
TRUST_PROXY=1

# ===== 数据库（PostgreSQL）=====
DATABASE_URL="postgresql://gamebox:CHANGE_ME@localhost:5432/gamebox?schema=public"

# ===== Redis（实时态 / 队列 / 缓存）=====
REDIS_URL="redis://localhost:6379"

# ===== JWT =====
# 至少 32 位随机串，且不得沿用本占位值；生产用弱密钥会被启动检查拒绝
# 生成：node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_STRING
# 生产由 deploy-on-server.sh 写成 8h；没有 refresh，签太久等于放大泄露窗口
JWT_EXPIRES_IN=1d

# ===== 安全 / 限流 =====
# 生产建议设置，逗号分隔；不设则生产关闭通配 CORS（依赖 nginx 同源反代）
# CORS_ORIGIN=https://yourdomain.com
# 已废弃的牌桌 Socket.IO 网关（/table 命名空间）。默认不启用。
# 它推整桌快照（含他人下注），且客户端已全部改走 HTTP，没有理由开着。
# 真要开：必须同时配 CORS_ORIGIN，否则不接任何跨域连接。
# TABLE_WS_ENABLED=1
# 全局兜底限流；登录/注册另有更严的接口级限流（30/分、10/分）
THROTTLE_TTL_MS=60000
THROTTLE_LIMIT=120

# ===== 业务参数 =====
PLATFORM_FEE_RATE=0.05
DEFAULT_BALANCE=0
# 多级分润最大层级（沿代理链向上分几级）
COMMISSION_MAX_LEVEL=5

# ===== 对象存储（APK / 美术，阶段一用本地 public）=====
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=./public/uploads

APP_BASE_URL=https://yourdomain.com

# ===== 运维探活 / Telegram 告警（可选，详见 scripts/health-alert.env.example）=====
# 服务端本身不发 Telegram；由宝塔计划任务跑：node scripts/health-alert.mjs
# HEALTH_URL=http://127.0.0.1:3000/api/health
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# ===== 每日维护窗（默认 04:00–06:00 上海时区）=====
# 临时关掉自动维护（调试用，生产勿开）
# DISABLE_DAILY_MAINT=1

# ===== seed 管理员（生产必设强密码；或 SKIP_ADMIN_SEED=1）=====
# SEED_ADMIN_PASSWORD=
# SKIP_ADMIN_SEED=0

# ===== 备份（见 docs/备份与恢复.md）=====
# 不用这里的变量：备份跑在服务器上，配置放 /opt/gamebox-platform/backup.env
# 宝塔 cron 每日 04:30：bash /opt/gamebox-platform/backup-on-server.sh

# ===== HTTPS =====
# 有域名后再在宝塔网站开启 SSL；未上域名前可先本机/IP 验收控制台。
