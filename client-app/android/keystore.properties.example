# 安卓正式签名配置模板
#
# 用法：复制成同目录的 keystore.properties 并填上真实值。
# 真实文件已在 .gitignore 里，不会被提交。
#
# 第一步，生成密钥库（有效期给足 25 年以上，到期就发不了更新了）：
#
#   keytool -genkeypair -v -keystore gamebox-release.jks \
#     -alias gamebox -keyalg RSA -keysize 2048 -validity 10000
#
# 生成的 gamebox-release.jks 放到 client-app/android/ 目录下。
#
# ⚠ 这个文件和口令必须异地备份。密钥库丢了，这个包名就再也发不出能覆盖安装的
#   更新，所有老用户只能卸载重装。这是安卓上无法挽回的一类事故。

# 密钥库文件名，相对 client-app/android/ 目录
storeFile=gamebox-release.jks

# 密钥库口令（keytool 里设的第一个口令）
storePassword=

# 密钥别名，与 keytool -alias 一致
keyAlias=gamebox

# 该别名的口令；keytool 里直接回车沿用密钥库口令的话，填成和 storePassword 相同
keyPassword=
